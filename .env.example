# -----------------------------------------------------------------------------
# Database (local Docker Postgres — see docker-compose.yml)
# For Neon production/preview: use the pooled connection for DATABASE_URL and
# the direct (non-pooled) connection for DIRECT_URL. Prisma migrate needs DIRECT_URL.
# Locally both can point at the same Docker connection string.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://nutaschola:nutaschola@localhost:5432/nutaschola?schema=public"
DIRECT_URL="postgresql://nutaschola:nutaschola@localhost:5432/nutaschola?schema=public"

# -----------------------------------------------------------------------------
# Auth.js
# Generate with: openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-long-random-secret"
# Optional: AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Single-tenant bootstrap (Excellence Kids)
# -----------------------------------------------------------------------------
DEFAULT_SCHOOL_SLUG="excellence-kids"
SEED_ADMIN_EMAIL="admin@excellencekids.edu.gh"
SEED_ADMIN_PASSWORD="ChangeMeNow1!"
SEED_ADMIN_FIRST_NAME="School"
SEED_ADMIN_LAST_NAME="Admin"

# Builder-only platform account (hidden from staff UI). Do not share with school users.
# Prod bootstrap: migrate deploy → npm run db:seed:school → npm run db:seed:super-admin
SEED_SUPER_ADMIN_EMAIL="super@nutaschola.local"
SEED_SUPER_ADMIN_PASSWORD="ChangeMeNow1!"
SEED_SUPER_ADMIN_FIRST_NAME="Platform"
SEED_SUPER_ADMIN_LAST_NAME="Builder"

# -----------------------------------------------------------------------------
# Neon Object Storage (optional in local dev — leave unset to skip real uploads)
# Provisioned via neon.ts (`nuta-schola` bucket) + `neon deploy` on a us-east-2
# project. `neon env pull` / `neon deploy` injects these AWS-standard vars:
# -----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_ENDPOINT_URL_S3=""
# AWS_REGION="us-east-2"

# -----------------------------------------------------------------------------
# Transactional email (SMTP). Leave blank locally to fall back to console logging.
# Never commit real SMTP credentials — set them only in .env / .env.local / Vercel.
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Excellence Kids"
